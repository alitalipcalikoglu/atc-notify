# --- Server ---
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/notify.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
RETENTION_DAYS=30

# --- Auth: id:secret[:role] entries, comma separated. Secrets >= 32 chars. Generate: openssl rand -hex 32
# Roles: readwrite (default: send, retry, list own messages), read (list and fetch own messages only), admin (also every key's messages).
NOTIFY_API_KEYS=shop:REPLACE_WITH_64_HEX_CHARS,blog:REPLACE_WITH_64_HEX_CHARS
RATE_LIMIT_MAX=600

# --- Email ---
# nodemailer URL. Use "json:" locally to log mails instead of sending.
SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_FROM="Example App <no-reply@example.com>"

# --- Delivery ---
MAX_ATTEMPTS=8
BACKOFF_BASE_MS=5000
BACKOFF_CAP_MS=3600000
WORKER_CONCURRENCY=5
WORKER_POLL_MS=500
LOCK_TTL_MS=120000
# How often an in-flight send renews its lock. Must stay well under LOCK_TTL_MS.
HEARTBEAT_MS=10000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-notify:…:write
# --- Suppressions and quotas
# Signs POST /v1/hooks/bounces (X-Notify-Signature: t=<unix>,v1=<hex HMAC-SHA256 of "<t>.<body>">). Empty = hook off. >= 32 chars.
BOUNCE_WEBHOOK_SECRET=
# Soft bounces (mailbox full, greylisting) before an address is suppressed.
SOFT_BOUNCE_LIMIT=3
# Recipients per key per UTC day (0 = no limit); per-key overrides as keyId=n,keyId2=n.
DAILY_SEND_LIMIT=0
KEY_DAILY_LIMIT=
# Mails per recipient address per hour (0 = no limit).
RECIPIENT_HOURLY_LIMIT=20
# One-click unsubscribe links (List-Unsubscribe) for messages sent with "unsubscribe": true. Both or neither.
PUBLIC_BASE_URL=
UNSUBSCRIBE_SECRET=
AUDIT_URL=
AUDIT_API_KEY=
